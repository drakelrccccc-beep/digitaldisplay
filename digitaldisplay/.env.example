# Digital Display Configuration
# Copy this file to .env and customize for your setup

# Google Slides URL (REQUIRED)
# Recommended: use the "Publish to web" embed URL from Google Slides.
#   1. Open your presentation in Google Slides
#   2. Go to File → Share → Publish to web
#   3. Select the "Embed" tab, choose your timing, and click "Publish"
#   4. Copy the src URL from the <iframe> code shown
#      It will look like:
#      https://docs.google.com/presentation/d/e/XXXXX/embed?start=true&loop=true&delayms=10000
#
# Both URL formats are supported:
#   Published embed URL (recommended – timing & loop settings already included):
#     SLIDES_URL=https://docs.google.com/presentation/d/e/YOUR_PUBLISHED_ID/embed?start=true&loop=true&delayms=10000
#
#   Regular edit/present URL (the app converts it to embed format automatically):
#     SLIDES_URL=https://docs.google.com/presentation/d/YOUR_PRESENTATION_ID/edit
SLIDES_URL=https://docs.google.com/presentation/d/e/YOUR_PUBLISHED_ID/embed?start=true&loop=true&delayms=10000

# Chromium Browser Path (OPTIONAL)
# Default: /usr/bin/chromium-browser (Raspberry Pi OS default)
# CHROMIUM_PATH=/usr/bin/chromium-browser
